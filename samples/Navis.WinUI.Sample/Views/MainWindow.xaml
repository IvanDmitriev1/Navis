<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Navis.WinUI.Sample.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:authentication="using:Navis.WinUI.Sample.Views.Authentication"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="using:Navis.WinUI"
    Title="Navis.WinUI Sample"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootElement">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="TitleBar" Grid.Row="0" />

        <Frame
            x:Name="RootFrame"
            Grid.Row="1"
            nav:NavigationHost.InitialPage="{nav:XamlType TypeName=authentication:AuthenticationShellPage}"
            nav:NavigationHost.IsEnabled="True" />
    </Grid>
</Window>
