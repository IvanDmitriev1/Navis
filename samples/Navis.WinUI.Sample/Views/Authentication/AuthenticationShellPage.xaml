<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.Authentication.AuthenticationShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Navis.WinUI"
    xmlns:views="using:Navis.WinUI.Sample.Views" 
    xmlns:authentication="using:Navis.WinUI.Sample.Views.Authentication">

    <Frame
        x:Name="AuthenticationFrame"
        nav:NavigationHost.InitialPage="{nav:XamlType TypeName=authentication:LoginPage}"
        nav:NavigationHost.IsEnabled="True" />
</Page>
