<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.Authentication.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="48">
        <StackPanel
            Width="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <FontIcon
                HorizontalAlignment="Left"
                FontSize="36"
                Glyph="&#xE72E;" />
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Welcome to Navis" />
            <TextBlock Text="This nested authentication Frame resets the root Frame through the login ViewModel navigation handle." TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                AutomationProperties.Name="Enter sample application"
                Command="{x:Bind ViewModel.CompleteLoginCommand}"
                Content="Enter application" />
        </StackPanel>
    </Grid>
</Page>
