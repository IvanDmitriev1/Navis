<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.NestedNavigation.WorkspaceHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Inner page one" />
        <TextBlock Text="Use the title-bar back button to return here before leaving the workspace." TextWrapping="Wrap" />
        <Button Command="{x:Bind ViewModel.OpenDetailsCommand}" Content="Open inner page two" />
    </StackPanel>
</Page>
