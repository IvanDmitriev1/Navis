<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.NestedNavigation.WorkspaceDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Padding="24" Spacing="12">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Inner page two" />
        <TextBlock Text="{x:Bind ViewModel.ReceivedParameter, Mode=OneWay}" TextWrapping="Wrap" />
        <Button Command="{x:Bind ViewModel.OpenHomeCommand}" Content="Navigate with this page's injected service" />
    </StackPanel>
</Page>
