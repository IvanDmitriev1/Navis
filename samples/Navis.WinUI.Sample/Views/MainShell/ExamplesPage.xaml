<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.MainShell.ExamplesPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Navis.WinUI">

    <nav:TitleBarNavigation.Content>
        <TextBlock Text="Examples" />
    </nav:TitleBarNavigation.Content>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Padding="32,24"
            HorizontalAlignment="Center"
            Spacing="16">
            <StackPanel Spacing="8">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Navigation examples" />
                <TextBlock
                    Text="Explore the navigation capabilities demonstrated by this sample."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                x:Name="ExamplesList"
                AutomationProperties.AutomationId="ExamplesList"
                AutomationProperties.Name="Navigation examples"
                ItemsSource="{x:Bind ViewModel.Examples}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,12"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        Style="{StaticResource SubtitleTextBlockStyle}"
                                        Text="{Binding Title}" />
                                    <TextBlock
                                        Text="{Binding Description}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ApiSurface}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="{Binding Title}"
                                    AutomationProperties.Name="{Binding Title}"
                                    Command="{Binding ViewModel.OpenExampleCommand, ElementName=RootPage}"
                                    CommandParameter="{Binding}"
                                    Content="Open"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
