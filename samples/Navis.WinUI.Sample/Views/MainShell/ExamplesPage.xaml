<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.MainShell.ExamplesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Navis.WinUI"
    xmlns:viewModels="using:Navis.WinUI.Sample.ViewModels.MainShell">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Padding="32,24"
            HorizontalAlignment="Center"
            Spacing="16">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Navigation examples" />
                <TextBlock Text="Explore the navigation capabilities demonstrated by this sample." TextWrapping="Wrap" />
            </StackPanel>

            <ListView
                x:Name="ExamplesList"
                AutomationProperties.AutomationId="ExamplesList"
                AutomationProperties.Name="Navigation examples"
                ItemsSource="{x:Bind ViewModel.Examples}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:NavigationExampleItemViewModel">
                        <Border
                            Margin="0,0,0,12"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ParameterExample.Title}" />
                                    <TextBlock Text="{x:Bind ParameterExample.Description}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ParameterExample.ApiSurface}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="{x:Bind ParameterExample.Title}"
                                    AutomationProperties.Name="{x:Bind ParameterExample.Title}"
                                    Command="{x:Bind OpenCommand}"
                                    CommandParameter="{x:Bind ParameterExample}"
                                    Content="Open" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
