<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.MainShell.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Navis.WinUI">

    <StackPanel
        MaxWidth="720"
        Padding="48"
        HorizontalAlignment="Left"
        Spacing="16">
        <TextBlock
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Library" />
        <TextBlock
            Text="The NavigationView adapter keeps this selection synchronized with the ContentFrame."
            TextWrapping="Wrap" />
        <Button
            AutomationProperties.Name="Go back"
            Content="Back"
            Click="OnBackClick" />
    </StackPanel>
</Page>
