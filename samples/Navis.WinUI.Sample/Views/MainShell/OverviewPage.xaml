<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.MainShell.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mainShell="using:Navis.WinUI.Sample.Views.MainShell"
    xmlns:nav="using:Navis.WinUI"
    NavigationCacheMode="Required">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="760"
            Padding="32,24"
            HorizontalAlignment="Center"
            Spacing="24">

            <TextBlock Text="{x:Bind ViewModel.SelectedSuggestion, Mode=OneWay}" />

            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Navis navigation sample" />
                <TextBlock Text="A focused sample for exploring navigation capabilities in a compact WinUI shell." TextWrapping="Wrap" />
            </StackPanel>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Navigation capabilities" />
                    <TextBlock Text="The shell combines its page frame, a synchronized NavigationView, and title-bar navigation." TextWrapping="Wrap" />
                    <TextBlock Text="The next examples will demonstrate declarative routes, typed parameters, guards, and parent or root navigation." TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Examples" />
                    <TextBlock Text="Explore declarative routes, typed parameters, and navigation guards." TextWrapping="Wrap" />
                    <Button
                        nav:Navigate.To="{nav:XamlType TypeName=mainShell:ExamplesPage}"
                        AutomationProperties.AutomationId="OverviewExamplesButton"
                        AutomationProperties.Name="Open Examples"
                        Content="Open Examples" />
                    <Button
                        nav:Navigate.Parameter="{x:Bind ViewModel.FeaturedParameterExample}"
                        nav:Navigate.To="{nav:XamlType TypeName=mainShell:ExampleDetailsPage}"
                        AutomationProperties.AutomationId="OverviewFeaturedExampleButton"
                        AutomationProperties.Name="Open featured example"
                        Content="Open Featured Example" />
                </StackPanel>
            </Border>

            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Parent and root navigation" />
                    <TextBlock Text="Open a standalone screen in the window content, then return to a fresh shell with a clean page frame journal." TextWrapping="Wrap" />
                    <Button
                        AutomationProperties.AutomationId="OverviewStandaloneButton"
                        AutomationProperties.Name="Open standalone page"
                        Command="{x:Bind ViewModel.OpenStandaloneCommand}"
                        Content="Open Standalone Page" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
