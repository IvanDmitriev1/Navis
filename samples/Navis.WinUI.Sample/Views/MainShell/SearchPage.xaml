<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Navis.WinUI.Sample.Views.MainShell.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:nav="using:Navis.WinUI"
    xmlns:views="using:Navis.WinUI.Sample.Views" 
    xmlns:mainShell="using:Navis.WinUI.Sample.Views.MainShell">

    <StackPanel
        MaxWidth="720"
        Padding="48"
        HorizontalAlignment="Left"
        Spacing="16">
        <TextBlock
            Style="{StaticResource TitleTextBlockStyle}"
            Text="Search" />
        <AutoSuggestBox
            AutomationProperties.Name="Search the sample"
            Header="Search"
            PlaceholderText="Type a query" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                AutomationProperties.Name="Go back"
                Content="Back"
                nav:Navigate.Kind="Back" />
            <Button
                AutomationProperties.Name="Open library page"
                Content="Open Library"
                nav:Navigate.To="{nav:XamlType TypeName=mainShell:LibraryPage}" />
        </StackPanel>
    </StackPanel>
</Page>
